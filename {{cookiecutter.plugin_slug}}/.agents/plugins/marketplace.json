{
  "name": "{{ cookiecutter.plugin_slug }}-marketplace",
  "interface": {
    "displayName": "{{ cookiecutter.plugin_name }}"
  },
  "plugins": [
    {
      "name": "{{ cookiecutter.plugin_slug }}",
      "source": {
